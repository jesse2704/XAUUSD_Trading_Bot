# Trading212 API Configuration
TRADING212_API_KEY=your_api_key_here
TRADING212_ENVIRONMENT=demo  # demo or live

# Instrument Configuration
INSTRUMENT=XAUUSD
TIMEFRAME=1h  # 1m, 5m, 15m, 1h, 4h, 1d

# Risk Management
RISK_PER_TRADE=0.01         # 1% risk per trade
MAX_DAILY_LOSS=0.02          # 2% max daily loss
MAX_DRAWDOWN=0.05            # 5% max drawdown
MAX_POSITION_SIZE=0.10       # 10% max position size
MAX_CONCURRENT_POSITIONS=3
COOLDOWN_MINUTES=30          # minutes to wait after a losing trade

# Strategy Parameters
# Momentum Strategy
EMA_FAST=9
EMA_SLOW=21
EMA_LONG_FAST=50
EMA_LONG_SLOW=200
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ADX_PERIOD=14
ADX_THRESHOLD=25

# Mean Reversion Strategy
BB_PERIOD=20
BB_STD=2.0

# Breakout Strategy
DONCHIAN_PERIOD=20
VOLUME_MULTIPLIER=1.5

# VWAP Strategy
VWAP_DEVIATION=0.005  # 0.5% deviation from VWAP

# Confluence Strategy
MIN_CONFLUENCE_SCORE=3  # minimum votes to place a trade

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/trading_bot.log

# Backtesting
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
INITIAL_CAPITAL=10000.0
